modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["undollar"]

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "build"]
run = ["pnpm", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33185
externalPort = 5000

[[ports]]
localPort = 33687
externalPort = 8080

[[ports]]
localPort = 34459
externalPort = 6800

[[ports]]
localPort = 38389
externalPort = 6000

[[ports]]
localPort = 38433
externalPort = 3003

[[ports]]
localPort = 39459
externalPort = 4200

[[ports]]
localPort = 40929
externalPort = 8099

[[ports]]
localPort = 41047
externalPort = 8000

[[ports]]
localPort = 42759
externalPort = 8081

[[ports]]
localPort = 43497
externalPort = 3001

[[ports]]
localPort = 43609
externalPort = 5173

[[ports]]
localPort = 44193
externalPort = 3000

[[ports]]
localPort = 44911
externalPort = 3002

[[ports]]
localPort = 45635
externalPort = 8008

[[ports]]
localPort = 45885
externalPort = 9000

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000
